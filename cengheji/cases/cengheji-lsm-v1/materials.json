{
  "case": "cengheji-lsm-v1",
  "title": "层合迹：LSM tombstone、范围删除与压实选择审阅",
  "narrative": "存储团队导入 WAL、memtable flush 与多层 SSTable 摘要，模拟 point/range tombstone 在 compaction 中的保留和下沉。",
  "coordinateBasis": {
    "seq": "全局单调序列号，原点 seq=0 保留；业务从 1 开始",
    "lsn": "WAL 字节流偏移坐标（单位：byte offset）",
    "keyOrder": "字节字典序；内部键序 (key↑, seq↓, Delete 先于 Set)",
    "range": "一律半开 [start,end)；端点以 utf8 原始表示保存",
    "size": "单位 byte（SSTable 摘要估算）",
    "time": "事件时间戳 unix-ms，仅为显示坐标；确定性身份来自内容摘要与计数器"
  },
  "materials": [
    {"id": "wal-01", "kind": "wal_record", "representation": "WAL#lsn=1024", "payload": {"id": "wal-01", "lsn": 1024, "seq": 10, "kind": "set", "key": {"raw": "a", "encoding": "utf8"}, "value": {"representation": "v-a-10", "encoding": "utf8"}}},
    {"id": "wal-02", "kind": "wal_record", "representation": "WAL#lsn=1071", "payload": {"id": "wal-02", "lsn": 1071, "seq": 20, "kind": "set", "key": {"raw": "c", "encoding": "utf8"}, "value": {"representation": "v-c-20", "encoding": "utf8"}}},
    {"id": "wal-03", "kind": "wal_record", "representation": "WAL#lsn=1120", "payload": {"id": "wal-03", "lsn": 1120, "seq": 30, "kind": "range_delete", "key": {"raw": "a", "encoding": "utf8"}, "range_end": {"raw": "c", "encoding": "utf8"}}},
    {"id": "wal-04", "kind": "flush_order", "representation": "memtable#1 flush", "payload": {"id": "flush-01", "seq_no": 1, "wal_ids": ["wal-01", "wal-02", "wal-03"], "output_file_id": "sst-l0-01.sst", "level": 0}},

    {"id": "sst-l0-02", "kind": "sstable_summary", "representation": "L0 ingested summary (overlap)", "payload": {
      "id": "sst-l0-02.sst", "level": 0, "state": "live", "origin": "ingested_summary",
      "key_range": {"start": {"raw": "b", "encoding": "utf8"}, "end": {"raw": "g", "encoding": "utf8"}, "intervalBasis": "byte-lexicographic [start,end)"},
      "size": {"raw": "24 byte", "unit": "byte", "magnitude": 24},
      "points": [
        {"id": "l02-p1", "seq": 25, "kind": "set", "key": {"raw": "b", "encoding": "utf8"}, "value": {"representation": "v-b-25", "encoding": "utf8"}},
        {"id": "l02-p2", "seq": 40, "kind": "set", "key": {"raw": "e", "encoding": "utf8"}, "value": {"representation": "v-e-40", "encoding": "utf8"}},
        {"id": "l02-p3", "seq": 70, "kind": "delete", "key": {"raw": "e", "encoding": "utf8"}},
        {"id": "l02-p4", "seq": 88, "kind": "set", "key": {"raw": "h", "encoding": "utf8"}, "value": {"representation": "v-h-88", "encoding": "utf8"}},
        {"id": "l02-p5", "seq": 88, "kind": "delete", "key": {"raw": "h", "encoding": "utf8"}}
      ],
      "ranges": [],
      "provenance": {"material_ids": ["sst-l0-02"]}
