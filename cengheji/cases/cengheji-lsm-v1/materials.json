    {"id": "sst-l2-f", "kind": "sstable_summary", "representation": "L2 旧数据（range 删除端点检验：rAC 恰好止于 c）", "payload": {
      "id": "sst-l2-f.sst", "level": 2, "state": "live", "origin": "ingested_summary",
